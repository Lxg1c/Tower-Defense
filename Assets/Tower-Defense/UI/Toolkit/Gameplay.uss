.game-document-root { height: 100%; }
.game-root {
  height: 100%; flex-grow: 1; color: #ecfaff;
  -unity-font-definition: url("project://database/Assets/TextMesh Pro/Fonts/LiberationSans.ttf");
}
.is-hidden { display: none; }
.top-bar {
  position: absolute; top: 20px; left: 27px; right: 26px;
  height: 99px; flex-direction: row; align-items: flex-start;
}
.effect-chip,
.side-panel, .screen-panel, .order-instruction {
  background-color: rgba(4, 18, 31, 0.90);
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #3a7889; border-bottom-color: #3a7889;
  border-left-color: #3a7889; border-right-color: #3a7889;
  border-top-left-radius: 6px; border-top-right-radius: 6px;
  border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
}
.icon-button, .wave-block, .economy-status {
  background-color: rgba(7, 29, 43, 0.94);
  border-width: 2px; border-color: #3b8f9c; border-radius: 14px;
}
.icon-button {
  width: 72px; height: 72px; margin: 2px 0 0 0; padding: 0;
  border-color: #68d9d4; flex-direction: row; align-items: center; justify-content: center;
}
.icon-button:hover { background-color: #124253; }
.icon-button:active { background-color: #1b596e; }
.pause-bar { width: 8px; height: 32px; background-color: #effcf9; border-radius: 1px; }
.pause-bar-left { margin-right: 10px; }
.wave-block {
  width: 348px; height: 99px; margin-left: 12px;
  background-color: rgba(7, 29, 43, 0.92);
}
.wave-accent {
  position: absolute; top: 6px; bottom: 6px; left: -2px;
  width: 5px; background-color: #43e1da; border-radius: 2px;
}
.wave-phase-label, .wave-label, .wave-total-label, .economy-caption, .coins-label, .income-label {
  margin: 0; padding: 0; -unity-font-style: bold;
}
.wave-phase-label {
  position: absolute; top: 6px; left: 18px; height: 19px;
  color: #7bede9; font-size: 14px; -unity-text-align: middle-left;
}
.wave-heading {
  position: absolute; top: 35px; left: 18px; height: 38px;
  flex-direction: row; align-items: center;
}
.wave-label { color: #f8fefc; font-size: 30px; }
.wave-total-label { color: #a4bac3; font-size: 19px; margin-left: 5px; }
.wave-steps {
  position: absolute; left: 20px; bottom: 9px; width: 240px; height: 5px;
  flex-direction: row;
}
.wave-step {
  flex-grow: 1; flex-basis: 0; height: 5px; margin-right: 9px;
  background-color: rgba(75, 104, 115, 0.7); border-radius: 1px;
}
.wave-step.is-current-or-past { background-color: #62eee5; }
.economy-status { width: 236px; height: 80px; margin-top: 2px; margin-left: auto; }
.economy-icon {
  position: absolute; left: 22px; top: 22px; width: 30px; height: 30px;
  background-color: #ffd66a; border-radius: 3px; align-items: center; justify-content: center;
}
.economy-icon-center { width: 15px; height: 15px; background-color: #103341; border-radius: 1px; }
.economy-caption { position: absolute; top: 7px; left: 65px; color: #8bd9e1; font-size: 14px; }
.coins-label {
  position: absolute; top: 24px; left: 62px; height: 42px;
  color: #ffffff; font-size: 34px; -unity-text-align: middle-left;
}
.income-label {
  position: absolute; right: 27px; top: 26px; height: 38px;
  color: #48e6d8; font-size: 18px; -unity-text-align: middle-right;
}
.core-alert { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.core-edge { position: absolute; background-color: rgba(255, 66, 88, 0.45); }
.core-edge-top { top: 0; left: 0; right: 0; height: 7px; }
.core-edge-bottom { bottom: 0; left: 0; right: 0; height: 7px; }
.core-edge-left { top: 0; bottom: 0; left: 0; width: 7px; }
.core-edge-right { top: 0; bottom: 0; right: 0; width: 7px; }
.core-warning {
  position: absolute; top: 86px; left: 50%; width: 290px; height: 42px; margin-left: -145px;
  flex-direction: row; align-items: center; justify-content: center;
  background-color: rgba(60, 13, 29, 0.93);
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #ff6881; border-bottom-color: #ff6881; border-left-color: #ff6881; border-right-color: #ff6881;
}
.core-warning-text { color: #fff1f2; font-size: 13px; -unity-font-style: bold; }
.core-warning-health { margin-left: 8px; color: #ffb5c0; font-size: 14px; -unity-font-style: bold; }
.tutorial-panel {
  position: absolute; bottom: 22%; left: 26%; width: 48%;
  padding: 11px 18px; background-color: #102535;
  border-width: 1px; border-color: #315566; border-left-width: 4px;
  border-left-color: #82ece4; border-radius: 12px;
}
.tutorial-title, .tutorial-text { margin: 0; padding: 0; white-space: normal; }
.tutorial-title { font-size: 22px; color: #edf9fb; -unity-font-style: bold; }
.tutorial-text { margin-top: 5px; font-size: 18px; color: #c8e1e8; }
.fps-label {
  position: absolute; top: 110px; right: 26px; margin: 0; padding: 6px 11px;
  color: #8bd9e1; background-color: rgba(7, 29, 43, 0.94);
  border-width: 1.5px; border-color: #3b8f9c; border-radius: 9px;
  font-size: 13px; -unity-font-style: bold;
}
.effect-row { position: absolute; top: 105px; left: 24px; flex-direction: row; }
.effect-chip {
  min-width: 110px; height: 36px; padding: 7px 12px; margin-right: 7px;
  color: #b7f5f1; font-size: 14px; -unity-font-style: bold;
  border-left-width: 3px; border-left-color: #b88cf0;
}
.spawn-preview { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.spawn-world-group {
  position: absolute; align-items: center;
}
.spawn-number {
  width: 46px; height: 46px; flex-shrink: 0; margin: 0; padding: 0;
  color: #fff2f5; background-color: #70283f; border-width: 1.5px;
  border-color: #f7839b; border-radius: 23px;
  font-size: 22px; -unity-text-align: middle-center; -unity-font-style: bold;
}
.spawn-composition { width: 100%; flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 5px; }
.spawn-type {
  width: 86px; height: 53px; flex-direction: row; align-items: center;
  justify-content: center; margin: 0 3px 4px; background-color: #102535;
  border-width: 1.5px; border-color: #315566; border-radius: 12px;
}
.spawn-type-icon { width: 46px; height: 46px; flex-shrink: 0; }
.spawn-type-count { margin: 0 0 0 2px; padding: 0; color: #edf9fb; font-size: 19px; -unity-font-style: bold; }
.spawn-edge-badge {
  position: absolute; width: 46px; height: 46px; align-items: center;
}
.spawn-edge-arrow { position: absolute; width: 26px; height: 26px; }
.spawn-edge-distance {
  position: absolute; top: 50px; min-width: 58px; height: 25px; margin: 0; padding: 0 7px;
  color: #edf9fb; background-color: #102535; border-width: 1px;
  border-color: #315566; border-radius: 9px;
  font-size: 16px; -unity-text-align: middle-center; -unity-font-style: bold;
}
.spawn-badge {
  position: absolute; min-width: 42px; height: 38px; padding: 7px 10px;
  color: #ffffff; background-color: #11384a;
  border-top-width: 2px; border-top-color: #66e9e7;
  border-top-left-radius: 19px; border-top-right-radius: 19px;
  border-bottom-left-radius: 19px; border-bottom-right-radius: 19px;
  -unity-font-style: bold; -unity-text-align: middle-center;
}
.start-wave-button {
  position: absolute; bottom: 21px; left: 50%; width: 372px; height: 93px;
  margin: 0; margin-left: -186px; padding: 0; border-width: 0;
  background-color: rgba(0, 0, 0, 0);
  background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/hud-start-wave-penpot.png");
  -unity-background-scale-mode: scale-to-fit;
  color: #162632; font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.start-wave-button:hover { -unity-background-image-tint-color: #fff3cd; }
.start-wave-button:active { -unity-background-image-tint-color: #e6bd72; }
.primary-button:hover { background-color: #92f9f4; }
.touch-controls { position: absolute; left: 0; right: 0; bottom: 0; height: 350px; }
.joystick-zone { position: absolute; left: 0; bottom: 0; width: 32%; max-width: 420px; height: 100%; }
.joystick {
  position: absolute; left: 24px; bottom: 36px; width: 280px; height: 280px;
  background-color: rgba(4, 29, 43, 0);
  padding: 0;
}
.joystick-art {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/joystick-base-penpot.png");
  -unity-background-scale-mode: scale-to-fit;
}
.joystick-sector {
  position: absolute; left: 0; top: 0; width: 100%; height: 100%;
  background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/joystick-sector-penpot.png");
  -unity-background-scale-mode: scale-to-fit;
  opacity: 0;
}
.joystick-sector.is-active { opacity: 1; }
.joystick-knob {
  position: absolute; left: 28.09%; top: 28.09%; width: 43.82%; height: 43.82%;
}
.joystick-knob-art {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/joystick-thumb-penpot.png");
  -unity-background-scale-mode: scale-to-fit;
}
.action-stack { position: absolute; right: 32px; bottom: 10px; width: 310px; height: 330px; }
.screen-button, .primary-button, .order-cancel, .build-action {
  color: #eaffff; background-color: rgba(5, 39, 56, 0.95);
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #67d8da; border-bottom-color: #327f8e;
  border-left-color: #327f8e; border-right-color: #327f8e;
  border-top-left-radius: 7px; border-top-right-radius: 7px;
  border-bottom-left-radius: 7px; border-bottom-right-radius: 7px;
  -unity-font-style: bold; -unity-text-align: middle-center;
}
.screen-button:hover, .build-action:hover { background-color: #1b596e; }
.small-action, .ultimate-button {
  position: absolute;
  margin: 0; padding: 0; border-width: 0;
  background-color: rgba(0, 0, 0, 0);
}
.small-action { width: 106px; height: 129px; }
.home-action { right: 190px; bottom: 0; }
.rally-action { right: 35px; bottom: 197px; }
.action-disc {
  position: absolute; top: 0; left: 0; width: 106px; height: 106px;
  border-radius: 53px; border-width: 2px; border-color: #7ee5e7;
  background-color: rgba(10, 35, 50, 0.9);
  align-items: center; justify-content: center;
}
.action-icon {
  width: 84px; height: 84px; border-radius: 42px; border-width: 1.5px;
  border-color: #b8fff3; background-color: rgba(23, 62, 76, 0.96);
  align-items: center; justify-content: center;
}
.action-icon-art { width: 48px; height: 48px; -unity-background-scale-mode: scale-to-fit; }
.rally-icon { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/hud-flag-penpot.png"); }
.home-icon { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/hud-home-penpot.png"); }
.small-action:hover .action-icon, .small-action:active .action-icon { background-color: #286578; }
.small-action:disabled .action-disc { opacity: 0.55; }
.action-label {
  position: absolute; left: 0; right: 0; bottom: 0; height: 22px; margin: 0; padding: 0;
  -unity-text-align: middle-center; color: #efffff; font-size: 15px; -unity-font-style: bold;
}
.ultimate-button { right: 0; bottom: 14px; width: 178px; height: 178px; border-radius: 89px; }
.ultimate-face {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/hud-ultimate-penpot.png");
  -unity-background-scale-mode: scale-to-fit;
}
.ultimate-button:hover .ultimate-face { opacity: 0.94; }
.ultimate-button:active .ultimate-face { opacity: 0.78; }
.ultimate-ready-halo {
  position: absolute; left: 2px; top: 2px; right: 2px; bottom: 2px;
  border-width: 4px; border-color: #f4e2ff; border-radius: 90px; opacity: 0;
  transition-property: opacity; transition-duration: 160ms;
}
.ultimate-ready .ultimate-ready-halo { opacity: 1; }
.ultimate-charge-ring { position: absolute; left: 13px; top: 13px; right: 13px; bottom: 13px; }
.ultimate-charge {
  position: absolute; left: 29%; right: 29%; top: 66%; height: 17%; margin: 0; padding: 0;
  color: #ffffff; font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.editor-hud-preview #tutorialPanel,
.editor-hud-preview #effectRow, .editor-hud-preview #spawnPreview { display: none; }
.editor-hud-preview #startWaveButton, .editor-hud-preview-desktop #desktopActions { display: flex; }
.editor-hud-preview-desktop #touchControls { display: none; }
.side-panel {
  position: absolute; right: 24px; top: 108px; width: 390px; height: 500px; max-height: 72%;
  padding: 18px; overflow: hidden;
  background-color: rgba(5, 21, 36, 0.97);
  border-top-width: 4px; border-top-color: #bb8df2;
}
.side-panel.panel-left { right: auto; left: 24px; }
.side-panel.single-card-panel { height: 356px; }
.panel-overline { color: #b995e4; font-size: 11px; letter-spacing: 2px; -unity-font-style: bold; margin-bottom: 4px; }
.panel-heading {
  color: #ffffff; font-size: 27px; margin-bottom: 14px;
  -unity-font-definition: url("project://database/Assets/TextMesh Pro/Examples & Extras/Fonts/Oswald-Bold.ttf");
}
.build-cards { flex-grow: 1; overflow: hidden; }
.build-card {
  height: 240px; flex-shrink: 0; padding: 13px; margin-bottom: 10px;
  background-color: rgba(17, 50, 68, 0.96);
  border-left-width: 4px; border-left-color: #63e9e5;
  border-bottom-width: 1px; border-bottom-color: #476b7a;
}
.build-card-header { height: 52px; flex-direction: row; align-items: center; margin-bottom: 5px; }
.build-card-icon {
  width: 48px; height: 48px; margin-right: 12px;
  background-color: rgba(8, 29, 47, 0.94);
  -unity-background-scale-mode: scale-to-fit;
}
.build-card-title {
  height: 34px; color: #ffffff; font-size: 22px;
  -unity-font-definition: url("project://database/Assets/TextMesh Pro/Examples & Extras/Fonts/Oswald-Bold.ttf");
}
.build-levels { flex-grow: 1; margin-bottom: 6px; }
.build-level-row { height: 25px; flex-direction: row; align-items: center; padding-left: 5px; }
.build-level-target {
  background-color: rgba(69, 193, 197, 0.18);
  border-left-width: 3px; border-left-color: #a8f7ef;
}
.build-level-number { width: 55px; color: #7df0ea; font-size: 13px; -unity-font-style: bold; }
.build-level-values { color: #d2e7ea; font-size: 13px; }
.build-action {
  height: 44px; flex-shrink: 0; font-size: 14px; -unity-text-align: middle-center;
  background-color: #3bdcdd; color: #072935;
  border-top-color: #9afff9; border-bottom-color: #1b959f;
}
.build-action:disabled, .primary-button:disabled { opacity: 0.45; }
.primary-button { height: 56px; font-size: 18px; color: #06232b; background-color: #4ae5e5; }
.order-layer { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.order-instruction {
  position: absolute; top: 22px; left: 50%; width: 460px; margin-left: -230px;
  padding: 14px; color: #eaffff; -unity-text-align: middle-center;
  border-left-width: 4px; border-left-color: #b98cf0;
}
.order-cancel { position: absolute; top: 22px; right: 24px; width: 144px; height: 54px; }
.screen-overlay {
  position: absolute; top: 0; bottom: 0; left: 0; right: 0;
  align-items: center; justify-content: center;
  background-color: rgba(1, 8, 18, 0.62);
}
.pause-menu {
  width: 537px; height: 456px; max-width: 92%; max-height: 94%;
  padding: 26px 38px 33px;
  background-color: #102535; border-width: 1.5px; border-color: #5b9ca8; border-radius: 27px;
}
.pause-menu-title {
  height: 70px; margin: 0 0 20px 0; padding: 0;
  color: #edf9fb; font-size: 39px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.pause-menu-button {
  flex-grow: 1; flex-basis: 0; min-height: 0; margin: 0 0 15px 0; padding: 0 8px;
  background-color: #162f40; border-width: 1.5px; border-color: #315566; border-radius: 15px;
  color: #edf9fb; font-size: 21px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.pause-menu-last { margin-bottom: 0; }
.pause-menu-button:hover { background-color: #204457; }
.pause-menu-button:active { background-color: #275669; }
.pause-menu-resume {
  background-color: #ffda73; border-width: 0; color: #192530;
}
.pause-menu-resume:hover { background-color: #ffe69a; }
.pause-menu-resume:active { background-color: #edbd53; }
.pause-confirm { height: auto; }
.pause-confirm-title { height: auto; margin-bottom: 12px; font-size: 30px; white-space: normal; }
.pause-confirm-copy {
  margin: 0 0 22px; padding: 0; white-space: normal;
  color: #bddde7; font-size: 17px; -unity-text-align: middle-center;
}
.pause-confirm .pause-menu-button { flex-grow: 0; flex-basis: auto; height: 52px; }
.pause-confirm .pause-confirm-cancel { margin-bottom: 0; }
.pause-confirm.is-restart .pause-confirm-actions { flex-direction: column-reverse; }
.pause-confirm.is-restart .pause-confirm-submit { margin-bottom: 0; }
.pause-confirm.is-restart .pause-confirm-cancel { margin-bottom: 15px; }
.benchmark-hidden { display: none; }
.benchmark-hud {
  position: absolute; top: 18px; align-self: center; flex-direction: row; align-items: center;
  padding: 6px 12px; background-color: #102535; border-width: 1px;
  border-color: #5b9ca8; border-radius: 12px;
}
.benchmark-progress { color: #edf9fb; font-size: 17px; }
.benchmark-hud .screen-button { width: 110px; height: 38px; margin: 0 0 0 12px; }
.screen-button.outcome-statistics { height: 54px; white-space: normal; }
.performance-panel {
  width: 700px; height: 520px; max-width: 94%; max-height: 92%; padding: 20px 26px;
  background-color: #102535; border-width: 1.5px; border-color: #5b9ca8; border-radius: 24px;
}
.benchmark-stages { flex-direction: row; margin: 8px 0 0; }
.benchmark-stage-button {
  flex-grow: 1; flex-basis: 0; height: 38px; margin: 0 5px 0 0; color: #edf9fb;
  background-color: #162f40; border-width: 1px; border-color: #315566; border-radius: 9px;
  font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.benchmark-stage-button.benchmark-stage-selected { color: #a3fcf2; border-color: #82ece4; background-color: #204457; }
.performance-report {
  flex-grow: 1; white-space: normal; color: #edf9fb; font-size: 17px;
  margin: 12px 0; padding: 0; -unity-text-align: upper-left;
}
.performance-actions { flex-direction: row; justify-content: space-between; }
.performance-actions .screen-button { width: 48%; height: 44px; margin: 0; }
.screen-panel {
  width: 470px; max-height: 90%; padding: 30px; align-items: center;
  background-color: rgba(3, 17, 29, 0.98);
  border-top-width: 4px; border-top-color: #b88cf0;
  border-bottom-color: #4f8394; border-left-color: #4f8394; border-right-color: #4f8394;
  border-top-left-radius: 14px; border-top-right-radius: 14px;
  border-bottom-left-radius: 14px; border-bottom-right-radius: 14px;
}
.screen-overline { color: #bfa0ed; font-size: 12px; letter-spacing: 2px; -unity-font-style: bold; }
.screen-title {
  color: #ffffff; font-size: 48px; margin-bottom: 18px;
  -unity-font-definition: url("project://database/Assets/TextMesh Pro/Examples & Extras/Fonts/Oswald-Bold.ttf");
}
.screen-subtitle { color: #bddde7; font-size: 17px; margin-bottom: 18px; }
.screen-panel .primary-button {
  width: 290px; align-self: center;
  border-top-left-radius: 28px; border-top-right-radius: 28px;
  border-bottom-left-radius: 28px; border-bottom-right-radius: 28px;
}
.screen-button {
  width: 280px; height: 50px; font-size: 15px; margin-bottom: 10px;
  border-top-left-radius: 25px; border-top-right-radius: 25px;
  border-bottom-left-radius: 25px; border-bottom-right-radius: 25px;
}
.pause-settings {
  width: 720px; height: 522px; max-width: 94%; max-height: 96%; padding: 19px 29px 24px;
  background-color: #102535; border-width: 1.5px; border-color: #5b9ca8; border-radius: 27px;
}
.pause-settings-header {
  height: 80px; flex-direction: row; align-items: center;
  border-bottom-width: 1.5px; border-bottom-color: #315566;
}
.pause-settings-back {
  width: 55px; height: 55px; margin: 0; padding: 0; border-width: 1.5px;
  border-color: #315566; border-radius: 15px; background-color: #162f40;
  color: #82ece4; font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.pause-settings-back:hover { background-color: #204457; }
.pause-settings-title {
  margin: 0 0 0 21px; padding: 0; color: #edf9fb; font-size: 36px; -unity-font-style: bold;
}
.pause-volume-row {
  flex-grow: 1; flex-basis: 0; min-height: 0; padding: 0 6px; justify-content: center;
}
.pause-volume-caption { flex-direction: row; align-items: center; justify-content: space-between; }
.pause-settings-label, .pause-volume-value {
  margin: 0; padding: 0; flex-shrink: 0; white-space: nowrap; -unity-font-style: bold;
}
.pause-settings-label { color: #edf9fb; font-size: 21px; }
.pause-volume-value { color: #82ece4; font-size: 19px; }
.pause-volume-input { height: 38px; margin: 3px -10px 0; }
.pause-volume-track {
  position: absolute; left: 10px; right: 10px; top: 16px; height: 7px;
  background-color: #264657; border-radius: 3.5px;
}
.pause-volume-fill { height: 100%; background-color: #60dad4; border-radius: 3.5px; }
.audio-slider { width: 100%; height: 38px; margin: 0; }
.audio-slider .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.audio-slider .unity-base-slider__dragger {
  top: 9px; width: 20px; height: 20px; background-color: #e2fff8; border-width: 0; border-radius: 10px;
}
.pause-fps-row {
  height: 100px; padding: 0 6px; flex-direction: row; align-items: center; justify-content: space-between;
  border-top-width: 1.5px; border-top-color: #315566;
}
.pause-fps-switch {
  width: 81px; height: 35px; margin: 0; padding: 0;
}
.pause-settings .pause-fps-switch,
.pause-settings .pause-fps-switch:hover,
.pause-settings .pause-fps-switch:active,
.pause-settings .pause-fps-switch:focus {
  background-color: rgba(0, 0, 0, 0); background-image: none; border-width: 0;
  transition-duration: 0s;
}
.pause-fps-track {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background-color: #2b4858; border-width: 1px;
  border-color: rgba(0, 0, 0, 0); border-radius: 17.5px;
}
.pause-fps-switch:focus .pause-fps-track { border-color: #68b6bc; }
.pause-fps-knob {
  position: absolute; left: 5px; top: 4px; width: 25px; height: 25px;
  background-color: #b1cdd5; border-radius: 12.5px;
}
.pause-fps-switch.is-on .pause-fps-track { background-color: #236c73; }
.pause-fps-switch.is-on .pause-fps-knob { left: 49px; background-color: #e2fff8; }

.health-bar-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-overflow-clip-box: content-box; }
.entity-health-bar {
    position: absolute;
    width: 46px;
    height: 8px;
    flex-direction: row;
    padding: 2px;
    border-radius: 2px;
    background-color: #07121b;
    translate: -50% -50%;
    --entity-health-color: #75e1c7;
}

.entity-health-bar--building { --entity-health-color: #ffd17b; }
.entity-health-bar--enemy { --entity-health-color: #ff8279; }
.entity-health-segment { flex: 1; background-color: #304652; border-radius: 1px; overflow: hidden; }
.entity-health-segment--spaced { margin-left: 1px; }
.entity-health-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: var(--entity-health-color); }
.entity-shield-track { position: absolute; left: 1px; right: 1px; top: -4px; height: 3px; background-color: #07121b; border-radius: 1px; overflow: hidden; }
.entity-shield-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: #6cc7ff; }

/* Compact build choice: role first, then one unambiguous purchase action. */
.side-panel {
  width: 410px; height: 425px; padding: 16px;
  border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px;
  border-top-color: #a58ad7; border-bottom-color: #a58ad7;
  border-left-color: #a58ad7; border-right-color: #a58ad7;
  border-top-left-radius: 14px; border-top-right-radius: 14px;
  border-bottom-left-radius: 14px; border-bottom-right-radius: 14px;
}
.side-panel.single-card-panel { height: 256px; }
.side-panel.single-card-panel.upgrade-panel { height: 300px; }
.build-card { height: 148px; padding: 0; background-color: rgba(5, 21, 36, 0); border-left-width: 0; border-bottom-width: 0; }
.build-card.build-card-upgrade { height: 192px; }
.build-card-header { height: 88px; margin-bottom: 10px; flex-direction: row; align-items: center; }
.build-card-icon { width: 70px; height: 70px; margin-right: 12px; border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-top-color: #77dfe5; border-bottom-color: #77dfe5; border-left-color: #77dfe5; border-right-color: #77dfe5; }
.build-card-summary { flex-grow: 1; flex-shrink: 1; }
.build-card-title { height: auto; font-size: 19px; margin-bottom: 5px; }
.build-card-description { color: #d5e6e9; font-size: 12px; white-space: normal; }
.build-upgrade-summary { color: #8dedee; font-size: 12px; margin-bottom: 8px; white-space: normal; }
.build-action {
  height: 52px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: center;
  background-color: #162f40; color: #edf9fb; border-width: 1px; border-color: #315566; border-radius: 10px;
}
.build-action:hover { background-color: #19414d; border-color: #82ece4; }
.build-action-label { margin: 0; padding: 0; font-size: 18px; -unity-font-style: bold; white-space: normal; }
.build-credit { position: relative; left: auto; top: auto; width: 16px; height: 16px; margin: 0 5px 0 10px; flex-shrink: 0; }
.build-credit .economy-icon-center { width: 8px; height: 8px; }
