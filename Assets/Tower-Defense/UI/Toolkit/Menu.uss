.menu-document-root { height: 100%; }
.menu-root {
  height: 100%; flex-grow: 1; color: #effaff;
  -unity-font-definition: url("project://database/Assets/TextMesh Pro/Fonts/LiberationSans.ttf");
  background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/bg.jpg");
  -unity-background-scale-mode: scale-and-crop;
}
.is-hidden { display: none; }
.menu-shade {
  position: absolute; top: 0; bottom: 0; left: 0; right: 0;
  background-color: rgba(2, 7, 19, 0.10);
}
.menu-shell {
  width: 440px; height: 100%; align-self: center;
  padding-top: 52px; padding-bottom: 30px;
}
.menu-header { align-items: center; margin-bottom: 16px; }
.brand-row { flex-direction: row; align-items: center; margin-bottom: 9px; }
.brand-mark {
  width: 9px; height: 9px; margin-right: 9px; background-color: #53e8e8;
  border-top-left-radius: 5px; border-top-right-radius: 5px;
  border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;
}
.eyebrow, .section-label, .micro-label, .card-overline {
  color: #7df3f0; font-size: 12px; -unity-font-style: bold; letter-spacing: 2px;
}
.title-block { flex-direction: row; align-items: center; }
.game-title {
  height: 58px; color: #ffffff; font-size: 49px;
  -unity-font-definition: url("project://database/Assets/TextMesh Pro/Examples & Extras/Fonts/Oswald-Bold.ttf");
}
.title-accent { margin-left: 10px; }
.title-rule { width: 72px; height: 3px; margin-top: 3px; margin-bottom: 10px; background-color: #57ebe9; }
.subtitle { color: #d4e6ee; font-size: 15px; }
.menu-page { flex-grow: 1; align-items: center; }
.home-page { width: 100%; padding-top: 14px; }
.section-label { margin-bottom: 12px; }
.page-title {
  color: #ffffff; font-size: 31px; margin-bottom: 14px;
  -unity-font-definition: url("project://database/Assets/TextMesh Pro/Examples & Extras/Fonts/Oswald-Bold.ttf");
}
.primary-button, .menu-button, .lab-button, .quiet-button, .back-button, .difficulty-button, .level-button, .skill-button {
  -unity-font-style: bold; -unity-text-align: middle-center;
  color: #ecffff; background-color: rgba(7, 47, 60, 0.94);
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #7beded; border-bottom-color: #27a2ae;
  border-left-color: #40d4dd; border-right-color: #40d4dd;
  border-top-left-radius: 30px; border-top-right-radius: 30px;
  border-bottom-left-radius: 30px; border-bottom-right-radius: 30px;
}
.primary-button {
  width: 324px; height: 62px; margin-bottom: 11px;
  color: #06242d; background-color: #48e5e5; font-size: 18px;
  border-top-width: 3px; border-bottom-width: 6px; border-left-width: 3px; border-right-width: 3px;
  border-top-color: #c2ffff; border-bottom-color: #16758d;
  border-left-color: #8ff4ef; border-right-color: #8ff4ef;
}
.primary-button:hover { background-color: #a1faf4; }
.primary-button:active { background-color: #39bdc9; border-bottom-width: 3px; }
.home-secondary { width: 300px; align-items: center; margin-bottom: 0; }
.menu-button, .lab-button, .quiet-button {
  width: 300px; height: 54px; margin-bottom: 10px; font-size: 16px;
}
.menu-button:hover, .lab-button:hover, .difficulty-button:hover, .level-button:hover, .skill-button:hover {
  background-color: rgba(19, 85, 103, 0.98);
}
.lab-button { color: #dcfbfa; font-size: 13px; }
.quiet-button { color: #c7e1e9; background-color: rgba(6, 27, 44, 0.75); }
.quiet-button:hover { color: #ffffff; background-color: #1a4b61; }
.back-button { width: 170px; height: 43px; margin-top: 10px; font-size: 12px; }
.back-button:hover { background-color: #1a5668; }
.compact-header .menu-shell { width: 760px; }
.compact-header .menu-header { margin-bottom: 6px; }
.compact-header .brand-row, .compact-header .subtitle { display: none; }
.compact-header .game-title { height: 45px; font-size: 37px; }
.compact-header .title-rule { margin-bottom: 4px; }
.campaign-open {
  background-color: #091824; background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/menu-background-penpot.png");
  -unity-background-scale-mode: scale-and-crop;
}
.campaign-open .menu-header, .campaign-open .menu-shade { display: none; }
.campaign-open .menu-shell { width: 100%; padding: 0; }
.campaign-page { width: 100%; height: 100%; }
.campaign-header-rule {
  position: absolute; left: 0; right: 0; top: 15.7%; height: 1px; background-color: #295263;
}
.campaign-top-actions {
  position: absolute; top: 3.2%; right: 2.6%; flex-direction: row; align-items: flex-start;
}
.campaign-credits {
  min-width: 140px; height: 51px; margin: 5px 17px 0 0; padding: 0 14px;
  flex-direction: row; align-items: center;
  background-color: #091a29; border-width: 1.5px; border-color: #4f91a5; border-radius: 25.5px;
}
.campaign-credit-icon {
  width: 29px; height: 29px; margin-right: 10px; border-radius: 4px;
  background-color: #ffd66a; align-items: center; justify-content: center;
}
.campaign-credit-center { width: 15px; height: 15px; background-color: #103341; border-radius: 2px; }
.campaign-credit-value { margin: 0; padding: 0; color: #f7faff; font-size: 21px; -unity-font-style: bold; }
.campaign-levels {
  position: absolute; left: 3.8%; right: 3.8%; top: 19%; bottom: 20%;
  flex-direction: row; justify-content: space-between; align-items: center;
}
.campaign-featured, .campaign-side {
  flex-shrink: 0; padding: 12px; background-color: #102b3d; border-width: 2px; border-radius: 27px;
}
.campaign-featured { width: 53%; height: 100%; border-color: #65e2e0; }
.campaign-side {
  width: 21.6%; height: 79%; margin: 0; border-color: #438097;
  background-color: #102535; align-items: stretch; justify-content: flex-start;
}
.campaign-side:hover { background-color: #193a4c; border-color: #65e2e0; }
.campaign-side:focus { border-color: #a9f9ed; }
.campaign-side.is-empty { visibility: hidden; }
.campaign-featured-art, .campaign-side-art {
  flex-grow: 1; min-height: 0; border-radius: 15px; background-color: #0b2331;
  -unity-background-scale-mode: scale-and-crop; overflow: hidden;
}
.campaign-art-1 { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Campaign/level-01-comic.png"); }
.campaign-art-2 { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Campaign/level-02-comic.png"); }
.campaign-art-3 { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Campaign/level-03-comic.png"); }
.campaign-index, .campaign-availability {
  position: absolute; top: 12px; height: 29px; margin: 0; padding: 0 12px;
  color: #bffcf1; background-color: #0d3443; border-width: 1px; border-color: #56b7c1; border-radius: 14.5px;
  font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.campaign-index { left: 12px; }
.campaign-availability { right: 12px; font-size: 13px; }
.campaign-details { height: 85px; flex-direction: row; align-items: center; padding: 3px 10px 0; }
.campaign-level-copy { flex-grow: 1; flex-basis: 0; min-width: 0; }
.campaign-level-title, .campaign-side-title {
  margin: 0; padding: 0; color: #f4fcff; -unity-font-style: bold;
  white-space: nowrap; text-overflow: ellipsis; overflow: hidden;
}
.campaign-level-title { font-size: 32px; }
.campaign-level-description, .campaign-side-copy {
  margin: 5px 0 0; padding: 0; color: #a8cdd2;
  white-space: nowrap; text-overflow: ellipsis; overflow: hidden;
}
.campaign-level-description { font-size: 16px; }
.campaign-side-title { margin-top: 9px; font-size: 24px; }
.campaign-side-copy { margin-bottom: 5px; font-size: 14px; }
.campaign-waves {
  min-width: 102px; height: 43px; margin: 0 0 0 10px; padding: 0 10px; flex-shrink: 0;
  color: #d0f5f2; background-color: #0a2b3b; border-width: 1px; border-color: #63c5cc; border-radius: 19px;
  font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.campaign-difficulties { height: 43px; flex-direction: row; align-items: center; padding: 0 10px; }
.campaign-difficulty-label {
  margin: 0 12px 0 0; padding: 0; color: #a8d1d7;
  font-size: 14px; -unity-font-style: bold;
}
.campaign-difficulty {
  flex-grow: 1; flex-basis: 0; min-width: 0; height: 39px; margin: 0 0 0 7px; padding: 0 4px;
  color: #d0eaec; background-color: #0e2a39; border-width: 1px; border-color: #447f8c; border-radius: 19.5px;
  font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap;
}
.campaign-difficulty:hover, .campaign-difficulty.is-selected {
  color: #f5ffff; background-color: #1b5360; border-color: #8df5e6;
}
.campaign-difficulty:disabled, .campaign-start:disabled { opacity: 0.48; }
.campaign-start {
  position: absolute; left: 50%; bottom: 4.1%; width: 372px; height: 77px;
  margin: 0 0 0 -186px; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0);
  background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/menu-start-penpot.png"); -unity-background-scale-mode: scale-to-fit;
  color: #162632; font-size: 26px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.campaign-start:hover { -unity-background-image-tint-color: #fff3cd; }
.campaign-start:active { -unity-background-image-tint-color: #e6bd72; }
.campaign-bottom-actions { position: absolute; bottom: 2.6%; flex-direction: row; }
.campaign-bottom-left { left: 2.1%; }
.campaign-bottom-right { right: 2.1%; }
.campaign-action {
  width: 106px; height: 109px; margin: 0; padding: 0; border-width: 0;
  background-color: rgba(0, 0, 0, 0); align-items: center; justify-content: flex-start;
}
.campaign-action:hover, .campaign-action:active, .campaign-action:focus {
  background-color: rgba(0, 0, 0, 0); border-width: 0;
}
.campaign-action-disc {
  width: 82px; height: 82px; border-width: 2px; border-color: #6fd4db; border-radius: 22px;
  background-color: #112d3d; align-items: center; justify-content: center;
}
.campaign-action:hover .campaign-action-disc, .campaign-action:focus .campaign-action-disc {
  background-color: #204457; border-color: #b9fffa;
}
.campaign-action-icon { width: 58px; height: 58px; -unity-background-scale-mode: scale-to-fit; }
.campaign-action-label {
  height: 24px; margin: 3px 0 0; padding: 0; color: #d0eaec;
  font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap;
}
.campaign-settings { width: 88px; height: 76px; }
.campaign-settings .campaign-action-disc { width: 52px; height: 52px; border-radius: 26px; }
.campaign-settings .campaign-action-icon { width: 50px; height: 50px; background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/menu-settings-penpot.png"); }
.campaign-skills .campaign-action-icon { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/menu-skills-penpot.png"); }
.campaign-loadout .campaign-action-icon { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/menu-loadout-penpot.png"); }
.campaign-lab .campaign-action-icon { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/menu-lab-penpot.png"); }
.campaign-guide .campaign-action-icon {
  width: 46px; height: 46px;
  background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/menu-guide-penpot.png");
}
.campaign-exit .campaign-action-icon { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/menu-exit-penpot.png"); }
.campaign-exit .campaign-action-disc { border-color: #708b98; background-color: #172735; }
.campaign-open .fps-label {
  top: 111px; right: 32px; border-width: 1px; border-color: #3b8f9c; border-radius: 9px;
}
.campaign-narrow .campaign-difficulty-label { display: none; }
.campaign-narrow .campaign-side-title { font-size: 20px; }
.campaign-narrow .campaign-side-copy { font-size: 12px; }
.campaign-narrow .campaign-level-title { font-size: 27px; }
.campaign-narrow .campaign-level-description { font-size: 14px; }
.campaign-narrow .campaign-action { width: 88px; }
.campaign-narrow .campaign-start { width: 310px; height: 65px; margin-left: -155px; font-size: 23px; }
.settings-card {
  width: 600px; padding: 28px; margin-top: 5px;
  background-color: rgba(3, 15, 28, 0.96);
  border-top-width: 3px; border-top-color: #bc8ef7;
  border-bottom-width: 1px; border-bottom-color: #3a8494;
  border-left-width: 1px; border-left-color: #3a8494;
  border-right-width: 1px; border-right-color: #3a8494;
  border-top-left-radius: 12px; border-top-right-radius: 12px;
  border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;
}
.card-overline { color: #d2abf8; margin-bottom: 17px; }
.field-label { color: #e4f4f6; font-size: 13px; -unity-font-style: bold; letter-spacing: 2px; }
.audio-slider { height: 42px; margin-top: 8px; }
.audio-slider .unity-base-slider__tracker { height: 8px; background-color: #294b5f; }
.audio-slider .unity-base-slider__dragger {
  width: 22px; height: 22px; background-color: #5fe8e8;
  border-top-left-radius: 11px; border-top-right-radius: 11px;
  border-bottom-left-radius: 11px; border-bottom-right-radius: 11px;
}
.value-label { color: #ffffff; font-size: 15px; margin-bottom: 18px; }
.settings-divider { height: 1px; background-color: #365c70; margin-bottom: 14px; }
.settings-card .menu-button { width: 220px; align-self: center; height: 46px; }
.money-label {
  align-self: center; color: #b6fbf7; font-size: 17px;
  padding: 9px 18px; margin-bottom: 16px;
  background-color: rgba(9, 46, 59, 0.92);
  border-left-width: 3px; border-left-color: #d8aafa;
}
.skill-list { width: 760px; flex-direction: row; flex-wrap: wrap; justify-content: center; }
.skill-card {
  width: 31%; min-width: 190px; margin-right: 10px; margin-bottom: 10px; padding: 16px;
  background-color: rgba(3, 15, 28, 0.95);
  border-top-width: 3px; border-top-color: #6be4e5;
  border-bottom-width: 1px; border-bottom-color: #3b7587;
  border-left-width: 1px; border-left-color: #3b7587;
  border-right-width: 1px; border-right-color: #3b7587;
  border-top-left-radius: 9px; border-top-right-radius: 9px;
  border-bottom-left-radius: 9px; border-bottom-right-radius: 9px;
}
.skill-art { height: 88px; margin-bottom: 11px; -unity-background-scale-mode: scale-to-fit; }
.skill-art-vitality { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/player.png"); }
.skill-art-firepower { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/shooting_tower.png"); }
.skill-art-rapidfire { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/AoE_tower.png"); }
.skill-name {
  color: #ffffff; font-size: 21px; margin-bottom: 7px;
  -unity-font-definition: url("project://database/Assets/TextMesh Pro/Examples & Extras/Fonts/Oswald-Bold.ttf");
}
.skill-copy { color: #c1dce5; font-size: 13px; white-space: normal; min-height: 37px; }
.skill-button { width: 100%; height: 44px; font-size: 12px; margin-top: 14px; }
.loadout-open { background-color: #061a29; background-image: none; }
.loadout-open .menu-shade, .loadout-open .menu-header { display: none; }
.loadout-open .fps-label { display: none; }
.loadout-open .menu-shell { width: 1328px; max-width: 96%; padding-top: 24px; padding-bottom: 16px; }
.loadout-page { width: 100%; align-items: stretch; }
.loadout-heading { height: 94px; flex-direction: row; align-items: flex-start; }
.loadout-back {
  width: 56px; height: 56px; margin-right: 16px; font-size: 31px;
  color: #f1ffff; background-color: #15384d; -unity-text-align: middle-center;
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #70d4d8; border-bottom-color: #70d4d8; border-left-color: #70d4d8; border-right-color: #70d4d8;
  border-top-left-radius: 10px; border-top-right-radius: 10px;
  border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
}
.loadout-title {
  flex-grow: 1; color: #f0ffff; font-size: 40px;
  -unity-font-definition: url("project://database/Assets/TextMesh Pro/Examples & Extras/Fonts/Oswald-Bold.ttf");
}
.loadout-money {
  min-width: 176px; height: 57px; padding: 12px; color: #fff3bf;
  background-color: #123044; font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center;
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #c69e56; border-bottom-color: #c69e56; border-left-color: #c69e56; border-right-color: #c69e56;
  border-top-left-radius: 10px; border-top-right-radius: 10px;
  border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
}
.loadout-body { width: 100%; height: 534px; flex-direction: row; }
.loadout-stage {
  position: relative; flex-grow: 1; height: 100%; margin-right: 24px;
  background-color: rgba(10, 34, 53, 0.97);
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #63d4d8; border-bottom-color: #63d4d8; border-left-color: #63d4d8; border-right-color: #63d4d8;
  border-top-left-radius: 14px; border-top-right-radius: 14px;
  border-bottom-left-radius: 14px; border-bottom-right-radius: 14px;
}
.loadout-orbit {
  position: absolute; left: 24%; top: 10%; width: 52%; height: 78%;
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #705a9d; border-bottom-color: #705a9d; border-left-color: #705a9d; border-right-color: #705a9d;
  border-top-left-radius: 220px; border-top-right-radius: 220px;
  border-bottom-left-radius: 220px; border-bottom-right-radius: 220px;
}
.loadout-portrait { position: absolute; left: 25%; top: 12%; width: 50%; height: 78%; -unity-background-scale-mode: scale-to-fit; }
.preview-base { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-current.png"); }
.preview-armor { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-armor-concept.png"); }
.preview-left { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-left-heavy-concept.png"); }
.preview-right { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-heavy-weapon-concept.png"); }
.preview-both { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-both-heavy-concept.png"); }
.preview-armor-left { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-armor-left-heavy-concept.png"); }
.preview-armor-right { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-combined-concept.png"); }
.preview-armor-both { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-armor-both-heavy-concept.png"); }
.loadout-slot {
  position: absolute; width: 190px; height: 78px; padding: 9px;
  color: #e8fdff; background-color: rgba(22, 63, 79, 0.95);
  font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center;
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #7ba7b5; border-bottom-color: #7ba7b5; border-left-color: #7ba7b5; border-right-color: #7ba7b5;
  border-top-left-radius: 8px; border-top-right-radius: 8px;
  border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
}
.loadout-slot:hover, .loadout-slot.is-focused { border-top-color: #83f0ea; border-bottom-color: #83f0ea; border-left-color: #83f0ea; border-right-color: #83f0ea; }
.armor-slot { left: 18px; top: 148px; }
.left-weapon-slot { left: 18px; top: 286px; }
.right-weapon-slot { right: 18px; top: 148px; }
.module-slot { right: 18px; top: 286px; }
.loadout-catalog {
  width: 543px; height: 312px; padding: 19px 21px; background-color: rgba(12, 34, 51, 0.97);
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #ad91d6; border-bottom-color: #ad91d6; border-left-color: #ad91d6; border-right-color: #ad91d6;
  border-top-left-radius: 14px; border-top-right-radius: 14px;
  border-bottom-left-radius: 14px; border-bottom-right-radius: 14px;
}
.loadout-tabs { height: 51px; flex-direction: row; padding-bottom: 13px; border-bottom-width: 1px; border-bottom-color: #607487; }
.loadout-tab {
  flex-grow: 1; height: 37px; margin-right: 4px; background-color: #183b4e; color: #e8ffff;
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #607f93; border-bottom-color: #607f93; border-left-color: #607f93; border-right-color: #607f93;
  -unity-font-style: bold; -unity-text-align: middle-center;
}
.loadout-tab.is-selected { background-color: #247183; border-top-color: #8df2ed; border-bottom-color: #8df2ed; border-left-color: #8df2ed; border-right-color: #8df2ed; }
.catalog-page { padding-top: 13px; }
.catalog-caption { margin-bottom: 10px; color: #acdce3; font-size: 12px; -unity-font-style: bold; }
.preview-card {
  width: 100%; height: 77px; margin-bottom: 9px; padding: 8px; flex-direction: row; align-items: center; color: #eefeff;
  background-color: #13364a; -unity-font-style: bold; -unity-text-align: middle-left;
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #5c8ba1; border-bottom-color: #5c8ba1; border-left-color: #5c8ba1; border-right-color: #5c8ba1;
  border-top-left-radius: 8px; border-top-right-radius: 8px;
  border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
}
.preview-card.is-selected { background-color: #1d5361; border-left-width: 4px; border-left-color: #80f2eb; }
.preview-card:hover { background-color: #255c70; }
.preview-art { width: 53px; height: 53px; margin-right: 10px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; background-color: #173b52; }
.armor-base-art { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-current.png"); }
.armor-assault-art { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-armor-concept.png"); }
.weapon-standard-art { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-current.png"); }
.weapon-heavy-art { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Previews/Loadout/r07-left-heavy-concept.png"); }
.preview-name { flex-grow: 1; color: #f3ffff; font-size: 15px; -unity-font-style: bold; }
.preview-status { padding: 7px; color: #172b34; background-color: #ffca58; font-size: 11px; -unity-font-style: bold; }
.preview-card.is-selected .preview-status { color: #efffff; background-color: #307987; }
.weapon-columns { flex-direction: row; }
.weapon-column {
  flex-grow: 1; width: 50%; height: 187px; padding: 8px; margin-right: 8px;
  background-color: #112c3d; border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #477288; border-bottom-color: #477288; border-left-color: #477288; border-right-color: #477288;
  border-top-left-radius: 8px; border-top-right-radius: 8px;
  border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
}
.weapon-column.is-focused { border-top-color: #80f2eb; border-bottom-color: #80f2eb; border-left-color: #80f2eb; border-right-color: #80f2eb; }
.weapon-column-title { height: 26px; color: #d9f7f8; font-size: 12px; -unity-font-style: bold; }
.weapon-preview { height: 65px; }
.weapon-preview .preview-art { width: 40px; height: 40px; margin-right: 5px; }
.weapon-preview .preview-name { font-size: 12px; }
.module-card { height: 78px; margin-bottom: 9px; padding: 9px; flex-direction: row; align-items: center; background-color: #173c4f; border-left-width: 4px; border-left-color: #7dece7; }
.overdrive-card { border-left-color: #be91ee; background-color: #302c48; }
.module-name { flex-grow: 1; color: #ffffff; font-size: 15px; -unity-font-style: bold; }
.module-button { width: 114px; height: 42px; color: #102c36; background-color: #ffca58; -unity-font-style: bold; -unity-text-align: middle-center; }
.module-button:hover { background-color: #ffe398; }
.module-button:disabled { opacity: 0.58; }
.loadout-narrow .menu-shell { padding-top: 12px; }
.loadout-narrow .loadout-heading { height: 57px; }
.loadout-narrow .loadout-title { font-size: 28px; }
.loadout-narrow .loadout-back { width: 43px; height: 43px; font-size: 24px; }
.loadout-narrow .loadout-money { height: 43px; min-width: 115px; font-size: 13px; }
.loadout-narrow .loadout-body { height: 316px; }
.loadout-narrow .loadout-stage { margin-right: 10px; }
.loadout-narrow .loadout-catalog { width: 47%; height: 100%; padding: 9px; }
.loadout-narrow .loadout-portrait { top: 3%; height: 94%; }
.loadout-narrow .loadout-slot { width: 100px; height: 48px; padding: 3px; font-size: 9px; }
.loadout-narrow .armor-slot, .loadout-narrow .right-weapon-slot { top: 60px; }
.loadout-narrow .left-weapon-slot, .loadout-narrow .module-slot { top: 205px; }
.loadout-narrow .weapon-column { margin-right: 3px; padding: 3px; }
.loadout-narrow .weapon-preview .preview-name { font-size: 10px; }
.loadout-narrow .weapon-preview .preview-art { width: 28px; height: 28px; }
.fps-label {
  position: absolute; top: 24px; right: 28px; padding: 6px 10px;
  color: #d6fafa; background-color: rgba(6, 29, 43, 0.88); font-size: 12px;
}


/* Campaign subpages share the Penpot header, surface and control palette. */
.subpage-open { background-color: #091824; background-image: none; }
.subpage-open .menu-shade, .subpage-open .menu-header { display: none; }
.subpage-open .menu-shell { width: 100%; max-width: 100%; padding: 0 32px 32px; }
.menu-subpage { width: 100%; align-items: stretch; min-height: 0; }
.subpage-heading {
  height: 91px; flex-shrink: 0; margin: 0 -32px 24px; padding: 0 32px;
  flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: #315566;
}
.subpage-back {
  width: 54px; height: 54px; flex-shrink: 0; margin: 0 22px 0 0; padding: 0;
  border-width: 1px; border-color: #315566; border-radius: 15px;
  background-color: #102535; color: #edf9fb; font-size: 31px; -unity-text-align: middle-center;
}
.subpage-back:hover { background-color: #19414d; border-color: #82ece4; }
.subpage-title {
  flex-grow: 1; min-width: 0; margin: 0; padding: 0; color: #edf9fb;
  font-size: 37px; -unity-font-style: bold;
}
.subpage-credits { height: 46px; min-width: 128px; margin: 0; border-color: #315566; background-color: #0c1f2d; }
.subpage-credits .campaign-credit-icon, .skill-upgrade .campaign-credit-icon { width: 24px; height: 24px; }
.subpage-credits .campaign-credit-center, .skill-upgrade .campaign-credit-center { width: 13px; height: 13px; }
.menu-settings-layout, .skill-tree-layout, .subpage-open .loadout-body {
  width: 100%; height: auto; flex-grow: 1; min-height: 0; flex-direction: row; justify-content: space-between;
}
.subpage-panel {
  background-color: #102535; border-width: 1px; border-color: #315566; border-radius: 21px; padding: 28px 30px;
}
.subpage-panel-title { margin: 0 0 14px; padding: 0; color: #edf9fb; font-size: 28px; -unity-font-style: bold; }
.menu-settings-layout { margin-top: 10px; }
.menu-settings-card { width: 48.8%; height: 374px; max-height: 100%; }
.menu-volume-row { margin-bottom: 15px; }
.menu-volume-caption, .menu-fps-row, .menu-extra-setting {
  flex-direction: row; align-items: center; justify-content: space-between;
}
.menu-setting-label, .menu-volume-value { margin: 0; padding: 0; white-space: nowrap; flex-shrink: 0; -unity-font-style: bold; }
.menu-setting-label { color: #edf9fb; font-size: 21px; }
.menu-volume-value { color: #82ece4; font-size: 19px; }
.menu-volume-input { height: 38px; margin: 3px -10px 0; }
.menu-volume-track {
  position: absolute; left: 10px; right: 10px; top: 16px; height: 7px;
  background-color: #264657; border-radius: 4px;
}
.menu-volume-fill { height: 100%; background-color: #60dad4; border-radius: 4px; }
.menu-volume-slider { width: 100%; height: 38px; margin: 0; }
.menu-volume-slider .unity-base-slider__tracker { background-color: rgba(0,0,0,0); border-width: 0; }
.menu-volume-slider .unity-base-slider__dragger {
  top: 9px; width: 20px; height: 20px; border-width: 0; border-radius: 10px; background-color: #e2fff8;
}
.menu-fps-row, .menu-extra-setting { height: 80px; }
.menu-fps-row, .menu-extra-setting-last { border-top-width: 1px; border-top-color: #315566; }
.menu-extra-button, .skill-upgrade {
  border-width: 1px; border-color: #315566; background-color: #162f40; color: #edf9fb;
  border-radius: 12px; -unity-font-style: bold;
}
.menu-extra-button {
  min-width: 42%; height: 49px; font-size: 16px; margin: 0; padding: 0 12px;
  color: #b1cdd5; -unity-text-align: middle-center;
}
.repeat-hints-status { margin: -5px 0 0; padding: 0; color: #82ece4; font-size: 15px; white-space: normal; }
.guide-page { flex-grow: 1; }
.guide-layout { flex-direction: row; flex-grow: 1; min-height: 0; }
.guide-entries { width: 40%; margin-right: 2%; padding: 19px; }
.guide-details { width: 58%; padding: 24px; }
.guide-entry {
  flex-direction: row; align-items: center; height: 74px; flex-shrink: 0;
  padding: 7px 10px; margin: 0 0 9px; background-color: #0c1e2b;
  border-width: 1px; border-color: #315566; border-radius: 12px;
}
.guide-entry:hover, .guide-entry:focus, .guide-entry.is-selected { background-color: #19414d; border-color: #82ece4; }
.guide-entry-icon { width: 53px; height: 53px; margin-right: 12px; background-color: #16394d; border-radius: 8px; flex-shrink: 0; }
.guide-entry-labels { flex-grow: 1; flex-shrink: 1; }
.guide-entry-title, .guide-role, .guide-description, .guide-meta-label, .guide-meta-value {
  padding: 0; margin: 0; white-space: normal;
}
.guide-entry-title, .guide-description, .guide-meta-value { color: #edf9fb; -unity-font-style: bold; }
.guide-entry-title, .guide-description { font-size: 18px; }
.guide-role, .guide-meta-label { color: #b1cdd5; font-size: 15px; }
.guide-role { margin-top: 3px; }
.guide-detail-role { color: #82ece4; -unity-font-style: bold; }
.guide-detail-body, .guide-meta, .guide-credit-row { flex-direction: row; }
.guide-art { width: 35%; height: 230px; flex-shrink: 0; background-color: #102e3e; border-width: 1px; border-color: #315566; border-radius: 18px; }
.guide-detail-copy { flex-grow: 1; flex-basis: 0; min-width: 0; margin-left: 20px; }
.guide-description { margin-top: 20px; margin-bottom: 20px; }
.guide-meta { min-height: 45px; align-items: center; justify-content: space-between; }
.guide-meta-first { border-top-width: 1px; border-top-color: #315566; }
.guide-meta-value { font-size: 16px; -unity-text-align: middle-right; flex-shrink: 1; }
.guide-credit-row { align-items: center; }
.guide-credit-icon { width: 16px; height: 16px; margin-right: 6px; border-radius: 3px; }
.guide-credit-icon .campaign-credit-center { width: 8px; height: 8px; }
.guide-badge { padding: 2px 8px; margin: 0 0 0 5px; background-color: #23524e; color: #c3fff0; border-width: 1px; border-color: #82ece4; border-radius: 10px; font-size: 12px; -unity-font-style: bold; }
.guide-menu-badge { position: absolute; right: 1px; top: -4px; }
.subpage-short .guide-entries, .subpage-short .guide-details { padding: 12px; }
.subpage-short .guide-entry { height: 57px; margin-bottom: 7px; }
.subpage-short .guide-entry-icon { width: 38px; height: 38px; margin-right: 8px; }
.subpage-short .guide-entry-title, .subpage-short .guide-description { font-size: 15px; }
.subpage-short .guide-art { height: 173px; }
.subpage-short .guide-description { margin-top: 12px; margin-bottom: 12px; }
.subpage-short .guide-meta { min-height: 32px; }
.language-dropdown {
  width: 42%; min-width: 120px; height: 49px; margin: 0;
}
.language-dropdown .unity-base-field__input {
  min-width: 0; height: 100%; margin: 0; padding: 0 14px;
  flex-direction: row; align-items: center; justify-content: space-between;
  border-width: 1px; border-color: #315566; border-radius: 10px;
  background-color: #162f40; color: #edf9fb; font-size: 16px; -unity-font-style: bold;
}
.language-dropdown:hover .unity-base-field__input, .language-dropdown:focus .unity-base-field__input {
  background-color: #19414d; border-color: #82ece4;
}
.language-dropdown .unity-base-popup-field__text { -unity-text-align: middle-left; margin: 0; padding: 0; }
.language-dropdown .unity-base-popup-field__arrow {
  width: 9px; height: 9px; margin: 0 2px 5px 8px; flex-shrink: 0;
  background-image: none; rotate: 45deg;
  border-bottom-width: 2px; border-right-width: 2px;
  border-bottom-color: #b1cdd5; border-right-color: #b1cdd5;
}
.menu-document-root > .unity-base-dropdown { position: absolute; top: 0; right: 0; bottom: 0; left: 0; }
.menu-document-root .unity-base-dropdown__container-outer {
  background-color: #102535; border-width: 1px; border-color: #528699; border-radius: 10px; overflow: hidden;
}
.menu-document-root .unity-base-dropdown__item { height: 40px; }
.menu-document-root .unity-base-dropdown__item-content {
  height: 100%; flex-direction: row; align-items: center;
}
.menu-document-root .unity-base-dropdown__checkmark { width: 8px; height: 8px; margin: 0 10px 0 14px; }
.menu-document-root .unity-base-dropdown__item:checked .unity-base-dropdown__checkmark {
  background-color: #82ece4; border-radius: 4px;
}
.menu-document-root .unity-base-dropdown__label { color: #edf9fb; font-size: 16px; margin: 0; padding: 0; }
.menu-document-root .unity-base-dropdown__item:hover { background-color: #19414d; }
.subpage-short .language-dropdown { height: 36px; }
.subpage-short .language-dropdown .unity-base-field__input { font-size: 14px; }
.menu-fps-switch, .menu-fps-switch:hover, .menu-fps-switch:active, .menu-fps-switch:focus {
  width: 72px; height: 32px; margin: 0; padding: 0; border-width: 0; transition-duration: 0s;
  background-color: rgba(0,0,0,0); background-image: none;
}
.menu-fps-track {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background-color: #2b4858; border-radius: 16px; border-width: 1px; border-color: rgba(0,0,0,0);
}
.menu-fps-switch:focus .menu-fps-track { border-color: #68b6bc; }
.menu-fps-knob {
  position: absolute; top: 3px; left: 4px; width: 24px; height: 24px;
  background-color: #b1cdd5; border-radius: 12px;
}
.menu-fps-switch.is-on .menu-fps-track { background-color: #236c73; }
.menu-fps-switch.is-on .menu-fps-knob { left: 42px; background-color: #e2fff8; }
.subpage-open .fps-label { top: auto; right: 32px; bottom: 10px; }
.fps-label { border-radius: 12px; border-width: 1px; border-color: #315566; }

.skill-tree { width: 59.8%; padding: 0; }
.skill-details { width: 38.2%; }
.skill-link { position: absolute; background-color: #547788; }
.skill-link-root { left: 50%; top: 34%; width: 2px; height: 12%; }
.skill-link-branch { left: 26%; right: 26%; top: 46%; height: 2px; }
.skill-link-left, .skill-link-right { top: 46%; width: 2px; height: 11%; }
.skill-link-left { left: 26%; }
.skill-link-right { right: 26%; }
.skill-node {
  position: absolute; width: 40%; height: 26%; margin: 0; padding: 0 13px;
  flex-direction: row; align-items: center; justify-content: flex-start;
  border-width: 1px; border-color: #315566; border-radius: 15px; background-color: #0d202e;
}
.skill-node-root { left: 30%; top: 8%; }
.skill-node-left { left: 6%; top: 56%; }
.skill-node-right { right: 6%; top: 56%; }
.skill-node:hover, .skill-node.is-selected { background-color: #19414d; border-color: #82ece4; }
.skill-node-icon {
  width: 49px; height: 49px; flex-shrink: 0; margin: 0 12px 0 0; padding: 0;
  color: #82ece4; font-size: 28px; -unity-text-align: middle-center;
  border-width: 1px; border-color: #315566; border-radius: 11px; background-color: #162f40;
}
.skill-node-copy { min-width: 0; flex-grow: 1; }
.skill-node-title, .skill-node-rank { margin: 0; padding: 0; -unity-text-align: middle-left; }
.skill-node-title { color: #edf9fb; font-size: 19px; -unity-font-style: bold; }
.skill-node-rank, .skill-detail-rank, .skill-detail-requirement { color: #b1cdd5; font-size: 17px; }
.skill-node.is-locked .skill-node-icon { color: #b1cdd5; }
.skill-details .subpage-panel-title { margin-bottom: 3px; }
.skill-detail-rank, .skill-detail-bonus, .skill-detail-requirement { margin: 0; padding: 0; white-space: normal; }
.skill-detail-bonus { margin-top: 29px; color: #82ece4; font-size: 21px; -unity-font-style: bold; }
.skill-detail-requirement { margin-top: 13px; min-height: 26px; }
.skill-rank-steps { flex-direction: row; margin: 24px -5px 23px; }
.skill-rank-step { flex-grow: 1; height: 8px; margin: 0 5px; border-radius: 4px; background-color: #284858; }
.skill-rank-step.is-earned { background-color: #60dad4; }
.skill-upgrade {
  width: 100%; height: 68px; margin: 0; padding: 0 18px; align-items: center; justify-content: space-between; flex-direction: row;
}
.skill-upgrade:hover { background-color: #19414d; border-color: #82ece4; }
.skill-upgrade:disabled { background-color: #162f40; opacity: 0.8; }
.skill-upgrade-price { flex-direction: row; align-items: center; }
.skill-upgrade-text { margin: 0; font-size: 21px; }

.subpage-open .loadout-stage, .subpage-open .loadout-catalog {
  height: 100%; background-color: #102535; border-color: #315566; border-radius: 21px;
}
.subpage-open .loadout-stage { width: 59.8%; flex-grow: 0; margin: 0; }
.subpage-open .loadout-catalog { width: 38.2%; padding: 19px 21px; }
.loadout-character-preview { position: relative; flex-grow: 1; min-height: 110px; }
.subpage-open .loadout-orbit { top: 8%; height: 86%; border-color: #315566; background-color: #123041; }
.subpage-open .loadout-portrait { top: 3%; height: 94%; }
.subpage-open .loadout-slot {
  width: 27.6%; height: 62px; margin: 0; padding: 3px;
  border-color: #315566; border-radius: 12px; background-color: #0c1e2b; white-space: normal;
}
.subpage-open .loadout-slot.is-focused, .subpage-open .loadout-slot:hover {
  background-color: #19414d; border-color: #82ece4;
}
.subpage-open .armor-slot, .subpage-open .module-slot { left: 3%; right: auto; }
.subpage-open .left-weapon-slot, .subpage-open .right-weapon-slot { left: auto; right: 3%; }
.subpage-open .armor-slot, .subpage-open .left-weapon-slot { top: 17%; }
.subpage-open .module-slot, .subpage-open .right-weapon-slot { top: 54%; }
.loadout-stats { flex-shrink: 0; margin: 0 15px 14px; padding: 9px 12px 6px; border-radius: 12px; background-color: #0c1e2b; }
.loadout-stats-title, .loadout-stat-name, .loadout-stat-value, .loadout-stats-note { margin: 0; padding: 0; }
.loadout-stats-title { color: #edf9fb; font-size: 18px; -unity-font-style: bold; margin-bottom: 5px; }
.loadout-stat-row { height: 23px; flex-direction: row; align-items: center; border-top-width: 1px; border-top-color: #193b49; }
.loadout-stat-header { color: #b1cdd5; font-size: 12px; }
.loadout-stat-name { width: 40%; white-space: nowrap; }
.loadout-stat-value { width: 20%; white-space: nowrap; -unity-text-align: middle-right; }
.loadout-stat-delta { color: #a0b9c7; -unity-font-style: bold; }
.loadout-stat-delta.is-positive { color: #86ecd2; }
.loadout-stat-delta.is-negative { color: #ffabac; }
.loadout-stats-note { margin-top: 5px; color: #aac7d2; font-size: 12px; white-space: normal; }
.loadout-tab { border-radius: 9px; background-color: #0c1e2b; border-color: #315566; }
.loadout-tab.is-selected { background-color: #19414d; border-color: #82ece4; }
.subpage-open .preview-card { height: 66px; margin-left: 0; margin-right: 0; background-color: #0c1e2b; border-color: #315566; }
.subpage-open .preview-card:hover, .subpage-open .preview-card.is-selected { background-color: #19414d; border-color: #82ece4; }
.preview-status { border-radius: 7px; color: #d6edef; background-color: #162f40; }
.subpage-open .weapon-column { width: auto; flex-basis: 0; min-width: 0; height: auto; }
.subpage-open #rightWeaponColumn { margin-right: 0; }
.subpage-open .weapon-preview { height: 58px; }
.subpage-open .weapon-preview .preview-name { white-space: normal; }

.subpage-short.subpage-open .menu-shell { padding: 0 23px 20px; }
.subpage-short .subpage-heading { height: 64px; margin: 0 -23px 15px; padding: 0 23px; }
.subpage-short .subpage-back { width: 42px; height: 42px; font-size: 24px; margin-right: 15px; }
.subpage-short .subpage-title { font-size: 28px; }
.subpage-short .subpage-credits { height: 36px; min-width: 99px; }
.subpage-short .subpage-panel { padding: 17px 20px; }
.subpage-short .subpage-panel-title { font-size: 22px; margin-bottom: 7px; }
.subpage-short .menu-settings-layout { margin-top: 5px; }
.subpage-short .menu-settings-card { height: 288px; }
.subpage-short .menu-setting-label, .subpage-short .menu-volume-value { font-size: 16px; }
.subpage-short .menu-volume-row { margin-bottom: 7px; }
.subpage-short .menu-fps-row, .subpage-short .menu-extra-setting { height: 61px; }
.subpage-short .menu-extra-button { height: 36px; font-size: 14px; }
.subpage-short .skill-node { padding: 0 8px; }
.subpage-short .skill-node-icon { width: 34px; height: 34px; font-size: 21px; margin-right: 7px; }
.subpage-short .skill-node-title { font-size: 14px; }
.subpage-short .skill-node-rank, .subpage-short .skill-detail-rank, .subpage-short .skill-detail-requirement { font-size: 13px; }
.subpage-short .skill-detail-bonus { margin-top: 18px; font-size: 16px; }
.subpage-short .skill-rank-steps { margin-top: 15px; margin-bottom: 15px; }
.subpage-short .skill-upgrade { height: 47px; }
.subpage-short .skill-upgrade-text { font-size: 16px; }
.subpage-short.subpage-open .loadout-slot { height: 44px; }
.subpage-short.subpage-open .loadout-catalog { padding: 12px; }
.subpage-short .loadout-tabs { height: 43px; padding-bottom: 6px; }
.subpage-short .loadout-stats { margin: 0 9px 7px; padding: 5px 7px; }
.subpage-short .loadout-stat-row { height: 17px; font-size: 11px; }
.subpage-short .loadout-stats-title { font-size: 13px; margin-bottom: 2px; }
.subpage-short .loadout-stats-note { font-size: 10px; margin-top: 2px; }
.subpage-short.subpage-open .preview-card { height: 48px; margin-bottom: 6px; }
.subpage-short .preview-art { width: 32px; height: 32px; }
.subpage-short .preview-name { font-size: 12px; }
.subpage-short .preview-status { font-size: 9px; padding: 4px; }

.armor-options { flex-direction: row; justify-content: space-between; }
.subpage-open .armor-preview {
  width: 32%; height: 196px; flex-direction: column; padding: 8px 4px;
  justify-content: space-between; border-left-width: 1px;
}
.subpage-open .armor-preview .preview-art { width: 100%; height: 103px; margin: 0; border-radius: 8px; }
.subpage-open .armor-preview .preview-name {
  flex-grow: 0; width: 100%; font-size: 13px; white-space: normal; -unity-text-align: middle-center;
}
.subpage-open .armor-preview .preview-status { width: 100%; -unity-text-align: middle-center; }
.subpage-short.subpage-open .armor-preview { height: 148px; }
.subpage-short.subpage-open .armor-preview .preview-art { height: 73px; }
.subpage-short.subpage-open .armor-preview .preview-name { font-size: 11px; }

.subpage-back, .skill-node-icon { align-items: center; justify-content: center; }
.subpage-back-icon, .skill-icon, .skill-lock-icon { -unity-background-scale-mode: scale-to-fit; }
.subpage-back-icon {
  width: 54%; height: 54%;
  background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/menu-back-penpot.png");
}
.skill-icon { width: 58%; height: 58%; }
.talent-vitality { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/talent-vitality-penpot.png"); }
.talent-firepower { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/talent-firepower-penpot.png"); }
.talent-rapid-fire { background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/talent-rapid-fire-penpot.png"); }
.skill-lock-icon {
  display: none; width: 17px; height: 17px; margin-left: 4px; flex-shrink: 0;
  background-image: url("project://database/Assets/Tower-Defense/Art/UI/Images/Controls/talent-lock-penpot.png");
}
.skill-node.is-locked .skill-lock-icon { display: flex; }
.skill-node-title { white-space: normal; }
.skill-detail-header { flex-direction: row; align-items: center; }
.skill-detail-icon { width: 60px; height: 60px; background-color: #19414d; }
.skill-detail-bonus { font-size: 19px; }
.subpage-short .skill-detail-icon { width: 44px; height: 44px; }
.subpage-short .skill-detail-bonus { font-size: 16px; }

