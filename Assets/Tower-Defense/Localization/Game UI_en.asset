    m_Metadata:
      m_Items: []
  - m_Id: 36026415308808
    m_Localized: Confirm construction
    m_Metadata:
      m_Items: []
  - m_Id: 36026415308809
    m_Localized: Build a turret to strengthen the core's defense.
    m_Metadata:
      m_Items: []
