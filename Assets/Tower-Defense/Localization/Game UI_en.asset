    m_Metadata:
      m_Items: []
  - m_Id: 1588584464
    m_Localized: Deploys allies to hold a position.
    m_Metadata:
      m_Items: []
  - m_Id: 1588584465
    m_Localized: Blocks the path and delays enemies.
    m_Metadata:
      m_Items: []
  - m_Id: 1588584466
